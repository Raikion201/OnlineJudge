{
  "realm": "online-judge",
  "enabled": true,
  "displayName": "Online Judge",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "defaultRoles": ["User"],
  "roles": {
    "realm": [
      { "name": "User", "description": "Standard user role" },
      { "name": "Admin", "description": "Administrator role" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["Admin", "User"]
    },
    {
      "username": "user",
      "enabled": true,
      "email": "user@example.com",
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "user123",
          "temporary": false
        }
      ],
      "realmRoles": ["User"]
    }
  ],
  "clients": [
    {
      "clientId": "oj-angular",
      "name": "Angular Web App",
      "publicClient": true,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ]
    },
    {
      "clientId": "api-gateway",
      "name": "API Gateway",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "api-gateway-secret-key",
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "bearerOnly": true,
      "redirectUris": [
        "http://localhost:8085/*"
      ],
      "webOrigins": [
        "http://localhost:8085"
      ],
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ]
    },
    {
